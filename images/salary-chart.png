<svg width="600" height="400" xmlns="http://www.w3.org/2000/svg">
  <rect width="600" height="400" fill="#f8fafc"/>
  <text x="300" y="30" text-anchor="middle" font-size="20" font-weight="bold" fill="#1e293b">薪资水平统计</text>
  <rect x="80" y="250" width="80" height="100" fill="#2563eb" opacity="0.8"/>
  <rect x="180" y="200" width="80" height="150" fill="#7c3aed" opacity="0.8"/>
  <rect x="280" y="150" width="80" height="200" fill="#10b981" opacity="0.8"/>
  <rect x="380" y="100" width="80" height="250" fill="#f59e0b" opacity="0.8"/>
  <rect x="480" y="80" width="80" height="270" fill="#ef4444" opacity="0.8"/>
  <text x="120" y="370" text-anchor="middle" font-size="12" fill="#64748b">应届</text>
  <text x="220" y="370" text-anchor="middle" font-size="12" fill="#64748b">1-3年</text>
  <text x="320" y="370" text-anchor="middle" font-size="12" fill="#64748b">3-5年</text>
  <text x="420" y="370" text-anchor="middle" font-size="12" fill="#64748b">5-8年</text>
  <text x="520" y="370" text-anchor="middle" font-size="12" fill="#64748b">8年+</text>
</svg>
